# CarePurse settings. Copy to .env (or run: cd services/gateway && npm run setup).
# NEVER commit .env or show it on screen. Stellar TESTNET only.

# ── Stellar (testnet) ──────────────────────────────────────
STELLAR_NETWORK=stellar:testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_EXPLORER_URL=https://stellar.expert/explorer/testnet

# ── USDC (Circle testnet). 7 decimals on Stellar. ──────────
USDC_CONTRACT_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
USDC_DECIMALS=7

# ── Facilitator ────────────────────────────────────────────
# backup = Coinbase (testnet, no key) · primary = Built on Stellar (needs a free key)
FACILITATOR=backup
FACILITATOR_BACKUP_URL=https://x402.org/facilitator
FACILITATOR_PRIMARY_URL=https://channels.openzeppelin.com/x402/testnet
FACILITATOR_PRIMARY_API_KEY=

# ── Wallets (npm run setup fills these in) ─────────────────
# Gateway wallet: receives payments.
GATEWAY_RECIPIENT=
GATEWAY_RECIPIENT_SECRET=
# Mhasibu's wallet: pays. Fund it only with small amounts.
AGENT_SECRET_KEY=

# ── Gateway ────────────────────────────────────────────────
GATEWAY_PORT=4021
GATEWAY_URL=http://localhost:4021
# Demo naira-per-USDC rate used to price each top-up size
NGN_PER_USDC=1470
# mock = sandbox tokens built in · vtpass = VTpass sandbox (later)
UTILITY_PROVIDER=mock
ORDERS_FILE=.data/orders.json
ORDER_TTL_MINUTES=10
VTPASS_SANDBOX_API_KEY=
VTPASS_SANDBOX_SECRET_KEY=

# ── Web app (later) ────────────────────────────────────────
PRIVY_APP_ID=
PRIVY_APP_SECRET=
LLM_API_KEY=
LLM_MODEL=
DATABASE_URL=
