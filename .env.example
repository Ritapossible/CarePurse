# CarePurse settings. Copy to .env (or run: cd services/gateway && npm run setup).
# NEVER commit .env or show it on screen. Stellar TESTNET only.

# ── Stellar (testnet) ──────────────────────────────────────
STELLAR_NETWORK=stellar:testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_EXPLORER_URL=https://stellar.expert/explorer/testnet

# ── USDC (Circle testnet). 7 decimals on Stellar. ──────────
USDC_CONTRACT_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
USDC_DECIMALS=7

# ── Facilitator ────────────────────────────────────────────
# backup = Coinbase (testnet, no key) · primary = Built on Stellar (needs a free key)
FACILITATOR=backup
FACILITATOR_BACKUP_URL=https://x402.org/facilitator
FACILITATOR_PRIMARY_URL=https://channels.openzeppelin.com/x402/testnet
FACILITATOR_PRIMARY_API_KEY=

# ── Wallets (npm run setup fills these in) ─────────────────
# Gateway wallet: receives payments.
GATEWAY_RECIPIENT=
GATEWAY_RECIPIENT_SECRET=
# Mhasibu's wallet: pays. Fund it only with small amounts.
AGENT_SECRET_KEY=

# ── Gateway ────────────────────────────────────────────────
GATEWAY_PORT=4021
GATEWAY_URL=http://localhost:4021
# Demo naira-per-USDC rate used to price each top-up size
NGN_PER_USDC=1470
# CarePurse's service fee on top of face value, in basis points (300 = 3%; 0 = no fee; at most 1000). The purse pays it;
# Mama never sees it, Adaeze does (receipts). Set the SAME value for the gateway and Mhasibu.
SERVICE_FEE_BPS=300
# mock = demo tokens built in · vtpass = VTpass SANDBOX (real API, test numbers, no real top-ups)
UTILITY_PROVIDER=mock
ORDERS_FILE=.data/orders.json
ORDER_TTL_MINUTES=10
# VTpass sandbox keys: sandbox.vtpass.com/account → API Keys. The gateway refuses any non-sandbox URL.
VTPASS_BASE_URL=https://sandbox.vtpass.com/api
VTPASS_API_KEY=
VTPASS_SECRET_KEY=
VTPASS_PUBLIC_KEY=
VTPASS_CONTACT_PHONE=08011111111

# ── Purse contract (Phase 2: limits on-chain) ──────────────
# npm run deploy-purse (packages/mhasibu) fills both in. GUARDIAN_SECRET stands in for the
# daughter's wallet in the demo, until Privy signs for her.
PURSE_CONTRACT_ID=
GUARDIAN_SECRET=
# Sign-up: the purse contract's code on testnet (npm run install-wasm fills it in). Each family's
# purse is deployed from it, with the daughter's Privy wallet as guardian.
PURSE_WASM_HASH=
# Testnet only: the wallet that sends "Get test USDC" to new purses. Empty = GUARDIAN_SECRET.
TREASURY_SECRET=
# Mama's sign-in code is shown on screen (no SMS provider yet). 0 to hide it.
SHOW_MAMA_CODE=1

# ── Mhasibu API and web app ────────────────────────────────
MHASIBU_PORT=4022
# Required for anything public: every Mhasibu route except /v1/status needs this key (24+ characters,
# e.g. openssl rand -hex 24). Without it, Mhasibu only answers requests from the same machine.
MHASIBU_API_KEY=
# 1 = show the "Try to take 7 USDC" button in the demo log panel
DEMO_MODE=1
# apps/web (apps/web/.env.local): its server relays to Mhasibu and adds the key; browsers never see it.
MHASIBU_URL=http://localhost:4022
# Required when the web app runs in production (next start): links must end with ?code=<this>.
# Without it the production web app keeps Mama's chat closed. Not needed for npm run dev.
WEB_ACCESS_CODE=

# ── Web app (later) ────────────────────────────────────────
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Mhasibu: a model understands Mama when a key is set; otherwise a scripted parser does.
# We use a private model on NEAR AI Cloud: a verifiable model that runs in a TEE (attested
# confidential hardware), so Mama's words stay private. OpenAI-style chat API.
# Key: LLM_API_KEY, or NEARAI_API_KEY. Claude instead: LLM_API=anthropic, LLM_BASE_URL empty,
# LLM_MODEL=claude-opus-5-5 (or OpenServ: https://inference-api.openserv.ai, claude-opus-5.5).
LLM_API=openai
LLM_BASE_URL=https://cloud-api.near.ai/v1
LLM_API_KEY=
LLM_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
PURSES_FILE=.data/purses.json
# Postgres for orders, purses, purchases, tokens and chat (survives restarts). Empty = the JSON
# files above. Hosted: Neon free tier, e.g. postgresql://user:pass@ep-xxx.neon.tech/carepurse?sslmode=require
# The gateway and Mhasibu can share one database (one table, carepurse_records).
DATABASE_URL=

# ── Privacy ────────────────────────────────────────────────
# The gateway's order routes (meter and phone numbers, tokens) need this key; Mhasibu sends it.
# Same value on both services. Empty = the gateway only answers its own machine (local dev).
GATEWAY_API_KEY=
# Seals every database row with AES-256-GCM before it reaches Postgres. Any long random string;
# keep a copy somewhere safe: without it, the stored rows can't be read. Empty = stored unencrypted.
DATA_ENCRYPTION_KEY=
# Key for the meter/phone fingerprints the purse contract stores (HMAC, salted per purse).
# Empty = derived from AGENT_SECRET_KEY. If it changes, run: npm run sync-purse
DEST_HASH_KEY=

# Mama's sign-in code and electricity token by SMS (Termii). Without it, sign-in is closed unless
# SHOW_MAMA_CODE=1 (demo only: the code is shown on screen).
TERMII_API_KEY=
TERMII_SENDER_ID=CarePurse
# TERMII_BASE_URL=https://v3.api.termii.com
