# CarePurse settings. Copy to .env (or run: cd services/gateway && npm run setup).
# NEVER commit .env or show it on screen. Stellar TESTNET only.

# ── Stellar (testnet) ──────────────────────────────────────
STELLAR_NETWORK=stellar:testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_EXPLORER_URL=https://stellar.expert/explorer/testnet

# ── USDC (Circle testnet). 7 decimals on Stellar. ──────────
USDC_CONTRACT_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
USDC_DECIMALS=7

# ── Facilitator ────────────────────────────────────────────
# backup = Coinbase (testnet, no key) · primary = Built on Stellar (needs a free key)
FACILITATOR=backup
FACILITATOR_BACKUP_URL=https://x402.org/facilitator
FACILITATOR_PRIMARY_URL=https://channels.openzeppelin.com/x402/testnet
FACILITATOR_PRIMARY_API_KEY=

# ── Wallets (npm run setup fills these in) ─────────────────
# Gateway wallet: receives payments.
GATEWAY_RECIPIENT=
GATEWAY_RECIPIENT_SECRET=
# Mhasibu's wallet: pays. Fund it only with small amounts.
AGENT_SECRET_KEY=

# ── Gateway ────────────────────────────────────────────────
GATEWAY_PORT=4021
GATEWAY_URL=http://localhost:4021
# Demo naira-per-USDC rate used to price each top-up size
NGN_PER_USDC=1470
# CarePurse's service fee on top of face value, in basis points (300 = 3%). The purse pays it;
# Mama never sees it, Adaeze does (receipts). Set the SAME value for the gateway and Mhasibu.
SERVICE_FEE_BPS=300
# mock = demo tokens built in · vtpass = VTpass SANDBOX (real API, test numbers, no real top-ups)
UTILITY_PROVIDER=mock
ORDERS_FILE=.data/orders.json
ORDER_TTL_MINUTES=10
# VTpass sandbox keys: sandbox.vtpass.com/account → API Keys. The gateway refuses any non-sandbox URL.
VTPASS_BASE_URL=https://sandbox.vtpass.com/api
VTPASS_API_KEY=
VTPASS_SECRET_KEY=
VTPASS_PUBLIC_KEY=
VTPASS_CONTACT_PHONE=08011111111

# ── Purse contract (Phase 2: limits on-chain) ──────────────
# npm run deploy-purse (packages/mhasibu) fills both in. GUARDIAN_SECRET stands in for the
# daughter's wallet in the demo, until Privy signs for her.
PURSE_CONTRACT_ID=
GUARDIAN_SECRET=

# ── Mhasibu API and web app ────────────────────────────────
MHASIBU_PORT=4022
WEB_ORIGIN=http://localhost:3000
# 1 = show the "Try to take 7 USDC" button in the demo log panel
DEMO_MODE=1
# apps/web reads this one (put it in apps/web/.env.local)
NEXT_PUBLIC_MHASIBU_URL=http://localhost:4022

# ── Web app (later) ────────────────────────────────────────
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Mhasibu: Claude understands Mama when a key is set; otherwise a scripted parser does.
# We use Claude through OpenServ (Anthropic Messages-compatible). Model IDs use dots there.
# For Anthropic directly: leave LLM_BASE_URL empty and use LLM_MODEL=claude-opus-5-5.
LLM_BASE_URL=https://inference-api.openserv.ai
LLM_API_KEY=
LLM_MODEL=claude-opus-5.5
PURSES_FILE=.data/purses.json
# Postgres for orders, purses, purchases, tokens and chat (survives restarts). Empty = the JSON
# files above. Hosted: Neon free tier, e.g. postgresql://user:pass@ep-xxx.neon.tech/carepurse?sslmode=require
# The gateway and Mhasibu can share one database (one table, carepurse_records).
DATABASE_URL=
