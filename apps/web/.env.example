# CarePurse web app. Set these in Vercel (Project → Settings → Environment Variables).
# The browser never sees them: only the server-side relay (src/app/api/mhasibu) reads them.

# Mhasibu's https URL (the API runs on Render: packages/mhasibu).
MHASIBU_URL=https://carepurse-mhasibu-xxxx.onrender.com
# The same value as MHASIBU_API_KEY on the Mhasibu service (Render generates it; copy it here).
MHASIBU_API_KEY=
# Required in production: the demo link must end with ?code=<this>. Without it the chat stays closed.
WEB_ACCESS_CODE=
# Privy (dashboard.privy.io): the App ID is public. Enable Email and Google, and add this site's
# address under Allowed domains. No Privy secret is needed: logins are checked with Privy's public keys.
NEXT_PUBLIC_PRIVY_APP_ID=
